# Copy to .env.local (local) or set in Vercel (staging/production).
# ALL of these are SERVER-ONLY. Never prefix them with NEXT_PUBLIC_.
# The browser never talks to Supabase directly; every request goes through the server.

# Supabase project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=
# Supabase "anon" (publishable) key — used server-side with the signed-in user's session; RLS applies.
SUPABASE_ANON_KEY=
# Supabase "service_role" (secret) key — used ONLY for invoice file storage and owner-initiated
# login-account creation, each after a database permission check. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=
# Public URL of this site, e.g. https://inventory.yourrestaurant.com
APP_URL=
# production | staging | development. Demo seeding refuses to run when production.
APP_ENV=

# Email reports (daily + weekly, with invoice photos attached), via Resend (https://resend.com).
# Leave empty until ready: reports are still generated and saved in Administration → Email reports.
RESEND_API_KEY=
# Sender, on a domain verified in Resend, e.g. "Pita Princess Reports <reports@yourrestaurant.com>"
EMAIL_FROM=
# Random string (32+ chars). Vercel Cron sends it to /api/cron/reports; nothing else can trigger reports.
CRON_SECRET=

# Local development only (scripts/local/*):
# LOCAL_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# DEMO_PASSWORD=choose-a-local-password
